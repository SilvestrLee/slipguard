APP_NAME=SlipGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0+ is the standard local/staging/production database (`I-01.2`,
# `PO-I01.2-001`) — verified via a disposable-database migrate:fresh pass,
# not just the repaired local install. See docs/06-engineering for the
# full setup procedure. Never commit a real password here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slipguard
DB_USERNAME=slipguard
DB_PASSWORD=

# SQLite remains the standard in-memory test database (phpunit.xml) — an
# intentional, unchanged choice, not a leftover default. Never point
# DB_CONNECTION at sqlite for a real local/staging/production environment.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional. Only needed to use the 21st.dev MCP server (design reference/
# inspiration lookups only — see .mcp.json and CLAUDE.md's Tool Invocation
# Policy). Never commit a real value here or in .mcp.json.
API_KEY_21ST=

# Optional. `php artisan slipguard:demo` (PO-U17.0-001 — the canonical
# DW-01 demo workspace) uses SLIPGUARD_DEMO_PASSWORD if set; otherwise it
# generates and prints a random password once. SLIPGUARD_DEMO_ENABLED must
# be explicitly true for the command to run in production at all — never
# set either of these to a real value in a committed .env file.
SLIPGUARD_DEMO_PASSWORD=
SLIPGUARD_DEMO_ENABLED=false

# Optional. U-17.2/U-17.3 (Parser Office provider payload validation — see
# docs/02-architecture/U-17.2-EVIDENCE-SOURCE-VIABILITY-ASSESSMENT.md).
# Trial/free-tier API keys for the two candidate providers. THE_ODDS_API_KEY
# is now also read by config/services.php for the U-17.5 Engineering
# Foundation Package (App\Domain\MarketIntelligence); SPORTMONKS_API_KEY
# remains validation-only, unused by application code. Never commit a real
# value — the account, its email, and any payment details are the
# founder's own; Parser Office/Engineering never create provider accounts.
SPORTMONKS_API_KEY=
THE_ODDS_API_KEY=

# U-17.5 — Capability B's Engineering Foundation Package
# (App\Domain\MarketIntelligence). Gates the feature entirely — no route,
# no public exposure — per U-17.4's "no public launch" compliance
# constraint. Must remain false until Product Office explicitly authorizes
# a public launch, not merely internal build-and-test.
MARKET_WIDE_PLANNER_ENABLED=false
