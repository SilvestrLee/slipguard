# OP-03 (RC1 Operations Programme) — production configuration template.
#
# Differs from .env.example only in the values that must genuinely change
# between local development and a real production deployment. Copy this
# to the production server's shared/.env (ops/deploy.sh's directory
# layout), fill in every blank, then delete this comment block — it is
# documentation, not something a running app should read.
#
# Prepared, not yet applied anywhere — no production environment exists
# yet (docs/08-operations/RC1_OPERATIONS_PROGRAMME.md).

APP_NAME=SlipGuard
APP_ENV=production
APP_KEY=                          # generate fresh on the server: php artisan key:generate --force — never reuse a dev key
APP_DEBUG=false                   # never true in production — leaks stack traces to visitors
APP_URL=https://your-domain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Ships to the monitoring service configured under OP-04, not just local
# files — see docs/08-operations/PRODUCTION_OPERATIONS_BLUEPRINT.md §O-04.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning                 # 'debug' is too noisy for production; 'warning' surfaces real problems

DB_CONNECTION=mysql
DB_HOST=127.0.0.1                 # or the managed-MySQL host, once that decision is made (blueprint §O-01/§O-10)
DB_PORT=3306
DB_DATABASE=slipguard
DB_USERNAME=slipguard
DB_PASSWORD=                      # a real, strong, unique credential — never the local dev password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# `PO-MVP-005` finding R-09 — must be true here. This is the one line in
# this template that, if left false, silently reopens a real security gap.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Blueprint §O-01: move uploads to durable object storage rather than the
# single VPS's local disk — set to 's3' once real credentials exist below.
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database          # adequate as-is — zero queued jobs exist in the app today (verified directly)

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=                        # a real transactional-email provider — not yet chosen
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@your-domain.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required if FILESYSTEM_DISK=s3 above — an S3-compatible bucket (AWS S3,
# DigitalOcean Spaces, or Cloudflare R2 — blueprint §O-01 prefers R2 for
# its zero egress fees at this scale). Also used by ops/*.sh's optional
# --disk flag for off-server backup storage (blueprint §O-05).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=                     # required for R2/Spaces; leave blank for real AWS S3
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Never enable the demo workspace or set a real demo password in production.
SLIPGUARD_DEMO_ENABLED=false
SLIPGUARD_DEMO_PASSWORD=

# Real provider credentials, once Parser Office/Product Office authorize a
# live integration beyond the current trial-key setup — not yet real here.
THE_ODDS_API_KEY=

# `PO-MVP-004`: Capability B is launch-authorized. Flip only once the
# release-quality gates that decision referenced are actually satisfied
# for this deployment specifically — see RC1_LAUNCH_BLOCKER_CLOSURE_PLAN.md.
MARKET_WIDE_PLANNER_ENABLED=true

# --- Monitoring (OP-04) — prepared, requires a real account ---
# Uncomment and fill in once a Sentry (or equivalent) account exists.
# SENTRY_LARAVEL_DSN=
